---
// Waitlist — static placeholder, no real submission backend.
// A native HTML form posts to a /thanks page that does not exist yet,
// so this page surfaces an honest "post is not wired" message
// instead of pretending to capture emails.
---

<section id="waitlist">
  <div class="container narrow">
    <header class="section-head">
      <p class="kicker">05 · Waitlist</p>
      <h2>Be the first to query the hub.</h2>
    </header>

    <p class="lede">
      Workshop build · local only. The form below does not submit anywhere yet
      (confirmed in <code>README.md</code>). When you wire a backend, point the
      form at it and the waitlist goes live.
    </p>

    <form class="waitlist" action="#" method="post" data-static="true" aria-describedby="waitlist-note">
      <label class="visually-hidden" for="waitlist-email">Email address</label>
      <div class="field">
        <input
          id="waitlist-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="you@inbox.dev"
        />
        <button type="submit">Notify me</button>
      </div>
      <p id="waitlist-note" class="note">
        Static placeholder · no data is sent or stored.
      </p>
    </form>

    <p class="also">
      Or, if you're shipping a resource you want surfaced: <a href="#model">read the model</a>.
    </p>
  </div>
</section>

<style>
  .lede {
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 50ch;
  }

  .waitlist { margin-top: var(--gap-3); }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .also {
    margin-top: var(--gap-3);
    font-size: var(--fs-small);
    color: var(--ink-mute);
  }
</style>

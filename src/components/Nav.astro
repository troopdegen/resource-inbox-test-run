---
// Top-of-page identity bar. Workshop build logo is a mark, not a real brand.
---

<header class="nav">
  <div class="container nav__inner">
    <a class="nav__brand" href="/" aria-label="Resource Inbox — home">
      <span class="nav__mark" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="2.5" y="3.5" width="17" height="15" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
          <path d="M6 8h10M6 11h10M6 14h6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
      </span>
      <span class="nav__wordmark">Resource&nbsp;Inbox</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      <a href="#how-it-works">How it works</a>
      <a href="#model">Model</a>
      <a href="#waitlist" class="nav__cta">Join waitlist <span aria-hidden="true">→</span></a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: saturate(120%) blur(6px);
    border-bottom: var(--rule-hair);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.85rem;
    gap: 1.5rem;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }
  .nav__brand:hover { color: var(--ember); }

  .nav__mark {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--ink);
    border-radius: 4px;
    color: var(--ink);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
  }
  .nav__links a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .nav__links a:hover { color: var(--ember); }

  .nav__cta {
    color: var(--ink) !important;
    border: 1px solid var(--ink);
    padding: 0.45rem 0.8rem;
    border-radius: 2px;
  }
  .nav__cta:hover {
    background: var(--ink);
    color: var(--paper) !important;
  }

  @media (max-width: 640px) {
    .nav__wordmark { display: none; }
    .nav__links { gap: 0.9rem; }
  }
</style>
